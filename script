RegisterCommand("food", "Collect carcasses. Usage: food bring / food eat", function(args, print, ok, err, warn, info)
	local mode = args[1] and args[1]:lower()

	if not mode then
		err("Usage: food bring / food eat")
		return
	end

	if CoS.FoodLoop then
		CoS.FoodLoop = nil
		ok("Food collection stopped.")
		return
	end

	local validNames = {
		["Carnivore Carcass"] = true,
		["Herbivore Carcass"] = true,
		["Plant Carcass"] = true,
	}

	if mode == "bring" then
		ok("Food bring started.")
		CoS.FoodLoop = true

		spawn(function()
			local VIM = game:GetService("VirtualInputManager")
			local Food = workspace:WaitForChild("Interactions"):WaitForChild("Food")

			local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if not root then
				err("Character not found.")
				CoS.FoodLoop = nil
				return
			end

			local originalCFrame = root.CFrame

			for _, item in ipairs(Food:GetChildren()) do
				if not CoS.FoodLoop then break end
				if item:IsA("Model") and validNames[item.Name] then
					root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
					if not root then break end

					if item.PrimaryPart then
						root.CFrame = item.PrimaryPart.CFrame * CFrame.new(0, 3, 0)
					end

					local targetCFrame = root.CFrame * CFrame.new(0, 0, 10)
					local tween = TweenService:Create(root, TweenInfo.new(0.5, Enum.EasingStyle.Linear), { CFrame = targetCFrame })
					tween:Play()
					tween.Completed:Wait()

					task.wait(0.8)

					VIM:SendKeyEvent(true, Enum.KeyCode.Y, false, game)
					task.wait(0.05)
					VIM:SendKeyEvent(false, Enum.KeyCode.Y, false, game)

					task.wait(1)

					root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
					if root then root.CFrame = originalCFrame end

					task.wait(2)

					VIM:SendKeyEvent(true, Enum.KeyCode.Y, false, game)
					task.wait(0.05)
					VIM:SendKeyEvent(false, Enum.KeyCode.Y, false, game)

					task.wait(1)
					info("Collected and dropped: " .. item.Name)
				end
			end

			ok("All carcasses brought.")
			CoS.FoodLoop = nil
		end)

	elseif mode == "eat" then
		ok("Food eat started.")
		CoS.FoodLoop = true

		spawn(function()
			local VIM = game:GetService("VirtualInputManager")
			local Food = workspace:WaitForChild("Interactions"):WaitForChild("Food")
			local FoodRemote = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Food")

			local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if not root then
				err("Character not found.")
				CoS.FoodLoop = nil
				return
			end

			local originalCFrame = root.CFrame

			local dietType = nil
			pcall(function()
				local hud = LocalPlayer.PlayerGui:WaitForChild("HUDGui", 5)
				local label = hud.BottomFrame.Other.DietType.HoverLabel
				dietType = label.Text
			end)

			info("Diet detected: " .. (dietType or "unknown"))

			if dietType == "Herbivore" then
				local foodTypes = {"Fruit", "Grass", "Berries"}

				local foodItems = {}
				for _, foodName in ipairs(foodTypes) do
					local item = Food:FindFirstChild(foodName)
					if item then foodItems[foodName] = item end
				end

				while CoS.FoodLoop do
					for _, foodName in ipairs(foodTypes) do
						if not CoS.FoodLoop then break end

						local foodItem = foodItems[foodName] or Food:FindFirstChild(foodName)
						if not foodItem then
							warn("Could not find: " .. foodName)
							task.wait(1)
							continue
						end

						root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
						if not root then break end

						local targetPos = foodItem:IsA("Model") and foodItem.PrimaryPart and foodItem.PrimaryPart.Position
							or foodItem:IsA("BasePart") and foodItem.Position

						if targetPos then
							root.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
						end

						task.wait(0.5)

						pcall(function()
							FoodRemote:FireServer(foodItem)
						end)

						info("Ate: " .. foodName)

						local waited = 0
						while CoS.FoodLoop and waited < 5 do
							task.wait(1)
							waited += 1
						end
					end

					root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
					if root then root.CFrame = originalCFrame end
					info("Returned to original position.")

					task.wait(1)
				end

			elseif dietType == "Carnivore" or dietType == "Omnivore" then
				for _, item in ipairs(Food:GetChildren()) do
					if not CoS.FoodLoop then break end
					if item:IsA("Model") and validNames[item.Name] then
						root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
						if not root then break end

						if item.PrimaryPart then
							root.CFrame = item.PrimaryPart.CFrame * CFrame.new(0, 3, 0)
						end

						task.wait(0.3)

						local eatTweenTarget = root.CFrame * CFrame.new(0, 0, 8)
						local eatTween = TweenService:Create(root, TweenInfo.new(0.4, Enum.EasingStyle.Linear), { CFrame = eatTweenTarget })
						eatTween:Play()
						eatTween.Completed:Wait()

						task.wait(0.2)

						VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
						task.wait(0.05)
						VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)

						info("Eating: " .. item.Name)

						local waited = 0
						while CoS.FoodLoop and waited < 15 do
							task.wait(1)
							waited += 1
						end

						if not CoS.FoodLoop then break end

						root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
						if root then root.CFrame = originalCFrame end

						task.wait(0.5)
					end
				end

				ok("All carcasses eaten.")
				CoS.FoodLoop = nil

			else
				err("Could not determine diet type: '" .. (dietType or "nil") .. "'")
				CoS.FoodLoop = nil
			end
		end)

	else
		err("Unknown mode '" .. mode .. "'.  Usage: food bring / food eat")
	end
end)

RegisterCommand("attack", "Attack a player. Usage: attack closest / attack all / attack <name>", function(args, print, ok, err, warn, info)
	local RunService = game:GetService("RunService")
	local Remotes = game:GetService("ReplicatedStorage"):WaitForChild("Remotes")
	local Workspace = game:GetService("Workspace")

	local mode = args[1] and args[1]:lower()

	if not mode then
		err("Usage: attack closest / attack all / attack <name>")
		return
	end

	if CoS.AttackClosestLoop then
		CoS.AttackClosestLoop = nil
		if CoS.Highlight then CoS.Highlight:Destroy() CoS.Highlight = nil end
	end

	if mode == "off" then
		ok("Attack stopped.")
		return
	end

	local function startLoop(getTarget)
		CoS.AttackClosestLoop = true
		local lastTarget = nil
		spawn(function()
			while CoS.AttackClosestLoop do
				RunService.Heartbeat:Wait()
				task.wait(CoS.AttackSpeed)
				pcall(function()
					local target, targetChar = getTarget()

					if target and targetChar then
						Remotes:WaitForChild("CharactersDamageRemote"):FireServer({ targetChar })

						if target ~= lastTarget then
							lastTarget = target
							info("Attacking: " .. (type(target) == "string" and target or target.Name))
						end

						if not CoS.Highlight then
							local highlight = Instance.new("Highlight")
							highlight.Name = "AttackClosestHighlight"
							highlight.FillColor = Color3.fromRGB(0, 136, 204)
							highlight.FillTransparency = 0.5
							highlight.OutlineColor = Color3.fromRGB(153, 204, 255)
							highlight.OutlineTransparency = 0.3
							highlight.Parent = Workspace
							CoS.Highlight = highlight
						end
						CoS.Highlight.Adornee = targetChar
					end
				end)
			end

			if CoS.Highlight then
				CoS.Highlight:Destroy()
				CoS.Highlight = nil
			end
		end)
	end

	if mode == "closest" then
		ok("Attacking closest player.")
		startLoop(function()
			local closest, closestChar = nil, nil
			local shortestDist = math.huge
			if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
				for _, plr in ipairs(Players:GetPlayers()) do
					if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
						local dist = (plr.Character.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
						if dist < shortestDist then
							shortestDist = dist
							closest = plr
							closestChar = plr.Character
						end
					end
				end
			end
			return closest, closestChar
		end)

	elseif mode == "all" then
		ok("Attacking all players.")
		CoS.AttackClosestLoop = true
		spawn(function()
			while CoS.AttackClosestLoop do
				task.wait(CoS.AttackSpeed)
				pcall(function()
					local targets = {}
					for _, plr in ipairs(Players:GetPlayers()) do
						if plr ~= LocalPlayer and plr.Character then
							table.insert(targets, plr.Character)
						end
					end
					if #targets > 0 then
						Remotes:WaitForChild("CharactersDamageRemote"):FireServer(targets)
					end
				end)
			end
			if CoS.Highlight then CoS.Highlight:Destroy() CoS.Highlight = nil end
		end)

	else
		local query = table.concat(args, " "):lower()
		local target = nil
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Name:lower():find(query, 1, true) then
				target = plr
				break
			end
		end
		if not target then
			err("Player not found: " .. query)
			return
		end
		ok("Attacking: " .. target.Name)
		startLoop(function()
			return target, target.Character
		end)
	end
end)

