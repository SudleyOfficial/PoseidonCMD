RegisterCommand("autofarm", "Auto farm shooms or shrines. Usage: autofarm shooms / autofarm shrine <name>", function(args, print, ok, err, warn, info)
	local mode = args[1] and args[1]:lower()

	if not mode then
		err("Usage: autofarm shooms / autofarm shrine <name>")
		return
	end

	if CoS.AutoFarmLoop then
		CoS.AutoFarmLoop = nil
		ok("Autofarm stopped.")
		return
	end

	if mode == "shooms" then
		ok("Autofarm shooms started.")
		CoS.AutoFarmLoop = true

		spawn(function()
			local VIM = game:GetService("VirtualInputManager")

			while CoS.AutoFarmLoop do
				local ShoomPiles = workspace:WaitForChild("Interactions"):WaitForChild("ShoomPiles")
				local piles = ShoomPiles:GetChildren()

				if #piles == 0 then
					info("No shoom piles found, waiting...")
					task.wait(5)
					continue
				end

				for _, shoom in ipairs(piles) do
					if not CoS.AutoFarmLoop then break end

					local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
					if not root then task.wait(1) continue end

					local shoomPos
					if shoom:IsA("Model") and shoom.PrimaryPart then
						shoomPos = shoom.PrimaryPart.Position
					elseif shoom:IsA("BasePart") then
						shoomPos = shoom.Position
					end

					if shoomPos then
						root.CFrame = CFrame.new(shoomPos + Vector3.new(0, 100, 0))
						task.wait(0.6)
						root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
						if root then
							root.CFrame = CFrame.new(shoomPos + Vector3.new(0, 3, 0))
						end
					end

					info("Collecting: " .. shoom.Name)

					local timer = 0
					while timer < 0.8 do
						if not CoS.AutoFarmLoop then break end
						VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
						task.wait(0.05)
						VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
						task.wait(0.05)
						timer += 0.1
					end
				end

				info("All shooms collected, restarting loop...")
				task.wait(2)
			end

			ok("Autofarm shooms stopped.")
		end)

	elseif mode == "shrine" then
		local shrineName = args[2] and args[2]:lower()

		if not shrineName then
			err("Usage: autofarm shrine <name>")
			info("Available: hellion, angelic, garra, verdant, boreal, eigion, novus, ardor")
			return
		end

		local pos = CoS_Shrines[shrineName]
		if not pos then
			err("Unknown shrine: '" .. shrineName .. "'")
			info("Available: hellion, angelic, garra, verdant, boreal, eigion, novus, ardor")
			return
		end

		ok("Autofarm shrine started: " .. shrineName)
		CoS.AutoFarmLoop = true

		spawn(function()
			local VIM = game:GetService("VirtualInputManager")

			while CoS.AutoFarmLoop do
				local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if not root then
					task.wait(1)
					continue
				end

				root.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
				task.wait(0.5)

				VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
				task.wait(0.1)
				VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)

				info("Shrine interacted: " .. shrineName)
				task.wait(1.5)
			end

			ok("Autofarm shrine stopped.")
		end)

	else
		err("Unknown mode '" .. mode .. "'.  Usage: autofarm shooms / autofarm shrine <name>")
	end
end)

