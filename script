RegisterCommand("games", "List all supported games", function(args, print, ok, err, warn, info)
	PrintBlank()
	PrintLine("  Supported Games", C.Accent)
	PrintBlank()
	local seen = {}
	for key, entry in pairs(GameRegistry) do
		if not seen[entry.name] then
			seen[entry.name] = true
			PrintLine("  " .. entry.name .. "   " .. tostring(#entry.commands) .. " Command(s)", C.Text)
		end
	end
	PrintBlank()
	PrintLine("  Usage: game <name>   —   e.g.  game cos", C.Dim)
	PrintBlank()
end)

RegisterCommand("game", "Show commands for a supported game. Usage: game <name>", function(args, print, ok, err, warn, info)
	if #args == 0 then
		PrintErr("Usage: game <name>  —  e.g.  game prison life")
		return
	end

	local query = table.concat(args, " "):lower()
	local entry = GameRegistry[query]

	if not entry then
		PrintErr("Game not found: '" .. query .. "'  —  type 'games' to list supported games")
		return
	end

	PrintBlank()
	PrintLine("  " .. entry.name, C.Accent)
	PrintDiv()

	if #entry.commands == 0 then
		PrintLine("  No commands registered yet for this game.", C.Dim)
	else
		for _, c in ipairs(entry.commands) do
			PrintLine(string.format("  %-20s %s", c.cmd, c.desc), C.Text)
		end
	end

	PrintBlank()
end)

