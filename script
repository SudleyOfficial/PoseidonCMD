RegisterCommand("spectate", "Spectate the player being attacked. Usage: spectate", function(args, print, ok, err, warn, info)
	if CoS.ViewLoop then
		CoS.ViewLoop = nil
		ok("Spectate stopped.")
		game:GetService("Workspace").CurrentCamera.CameraType = Enum.CameraType.Custom
		if CoS.CamPart then CoS.CamPart:Destroy() CoS.CamPart = nil end
	else
		ok("Spectate started.")
		CoS.ViewLoop = true
		spawn(function()
			local Workspace = game:GetService("Workspace")
			local RunService = game:GetService("RunService")
			local Mouse = LocalPlayer:GetMouse()

			local camPart = Instance.new("Part")
			camPart.Name = "PoseidonCamPart"
			camPart.Size = Vector3.new(0.1, 0.1, 0.1)
			camPart.Anchored = true
			camPart.CanCollide = false
			camPart.Transparency = 1
			camPart.Parent = Workspace
			CoS.CamPart = camPart

			Workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable

			local yaw = 0
			local pitch = -45
			local sensitivity = 0.4
			local distance = 40
			local lastX = Mouse.X
			local lastY = Mouse.Y

			local scrollConn = Mouse.WheelForward:Connect(function()
				distance = math.clamp(distance - 5, 5, 200)
			end)
			local scrollBackConn = Mouse.WheelBackward:Connect(function()
				distance = math.clamp(distance + 5, 5, 200)
			end)

			while CoS.ViewLoop do
				RunService.Heartbeat:Wait()
				pcall(function()
					local holding = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
					if holding then
						local dx = Mouse.X - lastX
						local dy = Mouse.Y - lastY
						yaw   = yaw   - dx * sensitivity
						pitch = math.clamp(pitch - dy * sensitivity, -89, 0)
					end
					lastX = Mouse.X
					lastY = Mouse.Y

					if CoS.Highlight and CoS.Highlight.Adornee and CoS.Highlight.Adornee:FindFirstChild("HumanoidRootPart") then
						local targetPos = CoS.Highlight.Adornee.HumanoidRootPart.Position
						local yawRad   = math.rad(yaw)
						local pitchRad = math.rad(pitch)
						local offset = Vector3.new(
							distance * math.cos(pitchRad) * math.sin(yawRad),
							distance * math.sin(-pitchRad),
							distance * math.cos(pitchRad) * math.cos(yawRad)
						)
						local camPos = targetPos + offset
						camPart.CFrame = CFrame.new(camPos)
						Workspace.CurrentCamera.CFrame = CFrame.new(camPos, targetPos)
					end
				end)
			end

			scrollConn:Disconnect()
			scrollBackConn:Disconnect()
			Workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
			if CoS.CamPart then CoS.CamPart:Destroy() CoS.CamPart = nil end
		end)
	end
end)

