local CoS_KOActive = false
local CoS_KOConnections = {}
local KOHealthConnections = {}

local function CleanupKO()
	CoS_KOActive = false
	for _, conn in ipairs(CoS_KOConnections) do
		pcall(function() conn:Disconnect() end)
	end
	CoS_KOConnections = {}
	KOHealthConnections = {}

	local WorkspaceGui = LocalPlayer.PlayerGui:FindFirstChild("WorkspaceGui")
	if WorkspaceGui then
		for _, gui in ipairs(WorkspaceGui:GetChildren()) do
			if gui.Name:sub(-#"KeenObserverUI") == "KeenObserverUI" then
				gui:Destroy()
			end
		end
	end
end

local function SpawnKOForPlayer(plr, WorkspaceGui)
	pcall(function()
		if not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then return end

		local guiName = plr.Name .. "KeenObserverUI"

		local existing = WorkspaceGui:FindFirstChild(guiName)
		if existing then existing:Destroy() end

		if KOHealthConnections[plr.Name] then
			pcall(function() KOHealthConnections[plr.Name]:Disconnect() end)
			KOHealthConnections[plr.Name] = nil
		end

		local template = KOFolder:FindFirstChild("TemplateKeenObserverUI")
		if not template then return end

		local clone = template:Clone()
		clone.Name = guiName
		clone.Adornee = plr.Character:FindFirstChild("HumanoidRootPart")
		clone.MaxDistance = 100
		clone.Size = UDim2.new(0, 160, 0, 200)
		clone.Parent = WorkspaceGui

		local moverLabel = clone.Container.Health:FindFirstChild("MoverLabel")
		if moverLabel then
			moverLabel.Text = plr.DisplayName .. "  @" .. plr.Name
		end

		local healthBar = clone.Container.HealthRow:FindFirstChild("HealthBar")

		local WsChars = workspace:FindFirstChild("Characters")
		local charFolder = WsChars and WsChars:FindFirstChild(plr.Name)
		local dataFolder = charFolder and charFolder:FindFirstChild("Data")
		local ailFolder  = charFolder and charFolder:FindFirstChild("Ailments")

		local maxH = 10000 -- adjust if you know the actual max hp
local function UpdateHealth()
    if not healthBar or not healthBar.Parent then return end
    if dataFolder then
        local h = dataFolder:GetAttribute("h")
        if h then
            local pct = math.clamp(h / maxH, 0, 1)
            healthBar.Size = UDim2.new(pct, 0, 1, 0)
            -- colour shifts red as health drops
            local g = math.floor(220 * pct)
            local r = math.floor(255 * (1 - pct))
            healthBar.BackgroundColor3 = Color3.fromRGB(r, g + 50, 50)
        end
    end
end

		UpdateHealth()

		if dataFolder then
			local conn = dataFolder.AttributeChanged:Connect(function(attr)
				if attr == "h" then
					task.defer(UpdateHealth)
				end
			end)
			KOHealthConnections[plr.Name] = conn
			table.insert(CoS_KOConnections, conn)
		end

		local AilmentsFrame = clone.Container:FindFirstChild("Ailments")
		if AilmentsFrame then
			for _, ch in ipairs(AilmentsFrame:GetChildren()) do
				if ch:IsA("ImageButton") then ch:Destroy() end
			end

			if ailFolder then
				local order = 0
				for attrName, attrVal in pairs(ailFolder:GetAttributes()) do
					-- Only show ailments with a value greater than 0
					if attrVal ~= nil then
						order += 1
						local DefaultBtn = KOFolder.TemplateKeenObserverUI.Container.Ailments:FindFirstChild("Default")
						if not DefaultBtn then continue end

						local btn = DefaultBtn:Clone()
						btn.Name = attrName
						btn.LayoutOrder = order

						local lbl = btn:FindFirstChild("AilmentLabel")
						if lbl then lbl.Text = attrName end

						btn.Parent = AilmentsFrame
					end
				end
			end
		end
	end)
end

