-- // ── Core terminal engine ──────────────────────────────────────────

local Commands    = {}
local history     = {}
local histIdx     = 0
local lineOrder   = 0

local function PrintLine(text, color)
	lineOrder += 1
	local row = Instance.new("Frame")
	row.Size               = UDim2.new(1, 0, 0, 0)
	row.AutomaticSize      = Enum.AutomaticSize.Y
	row.BackgroundTransparency = 1
	row.LayoutOrder        = lineOrder
	row.ZIndex             = 3
	row.Parent             = Output

	local lbl = Instance.new("TextLabel")
	lbl.Size               = UDim2.new(1, 0, 0, 0)
	lbl.AutomaticSize      = Enum.AutomaticSize.Y
	lbl.BackgroundTransparency = 1
	lbl.Text               = text or ""
	lbl.TextColor3         = color or C.Text
	lbl.TextSize           = 13
	lbl.Font               = Enum.Font.Code
	lbl.TextXAlignment     = Enum.TextXAlignment.Left
	lbl.TextWrapped        = true
	lbl.ZIndex             = 4
	lbl.Parent             = row

	task.defer(function()
		Output.CanvasPosition = Vector2.new(0, math.huge)
	end)
end

local function PrintBlank()    PrintLine("") end
local function PrintDiv()      PrintLine("────────────────────────────────────────────────────────", C.Muted) end
local function PrintOk(msg)    PrintLine("  [  OK  ]  " .. msg, C.Green) end
local function PrintErr(msg)   PrintLine("  [ ERR  ]  " .. msg, C.Red) end
local function PrintWarn(msg)  PrintLine("  [ WARN ]  " .. msg, C.Yellow) end
local function PrintInfo(msg)  PrintLine("  [ INFO ]  " .. msg, C.Dim) end

local function RegisterCommand(name, desc, fn)
	Commands[name:lower()] = { desc = desc or "", func = fn }
end

local function Execute(raw)
	if not raw or raw:match("^%s*$") then return end

	PrintLine(LocalPlayer.Name .. "@poseidon " .. raw, C.Dim)

	table.insert(history, 1, raw)
	if #history > 200 then table.remove(history) end
	histIdx = 0

	local parts = {}
	for w in raw:gmatch("%S+") do table.insert(parts, w) end
	local cmd  = parts[1] and parts[1]:lower() or ""
	local args = {}
	for i = 2, #parts do table.insert(args, parts[i]) end

	if cmd == "clear" or cmd == "cls" then
		for _, ch in ipairs(Output:GetChildren()) do
			if ch:IsA("Frame") then ch:Destroy() end
		end
		lineOrder = 0
		return
	end

	if cmd == "playerlist" or cmd == "pl" then
		playerListOpen = not playerListOpen
		UpdatePanelPosition()
		PlayerListPanel.Visible = playerListOpen
		if playerListOpen then
    BuildPlayerList()
    PrintOk("Player list opened. Click a name to paste their username.")
    task.delay(0, function()
        while playerListOpen do
            task.wait(3)
            if playerListOpen then
                BuildPlayerList()
            end
        end
    end)
			PrintOk("Player list opened. Click a name to paste their username.")
		else
			PrintOk("Player list closed.")
		end
		return
	end

	if cmd == "help" then
		PrintBlank()
		PrintLine("  Poseidon Terminal  —  command reference", C.Accent)
		PrintBlank()
		PrintLine("  clear / cls          Clear the terminal", C.Text)
		PrintLine("  playerlist / pl      Toggle player list panel", C.Text)
		PrintLine("  help                 Show this message", C.Text)
		PrintLine("  echo <text>          Print text to output", C.Text)
		PrintLine("  exit                 Close the terminal", C.Text)
		local any = false
		for name, data in pairs(Commands) do
			if not any then
				PrintBlank()
				PrintLine("  Loaded commands:", C.Accent)
				any = true
			end
			PrintLine(string.format("  %-16s %s", name, data.desc), C.Text)
		end
		if not any then
			PrintBlank()
			PrintLine("  No additional commands loaded.", C.Dim)
		end
		PrintBlank()
		return
	end

	if cmd == "echo" then
		PrintLine("  " .. table.concat(args, " "), C.Text)
		return
	end

	if cmd == "exit" then
		PrintOk("Closing terminal...")
		task.delay(0.4, function()
			Tween(Win, { Size = UDim2.new(0, WIN_W, 0, 0) }, 0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			task.delay(0.25, function() Gui:Destroy() end)
		end)
		return
	end

	if Commands[cmd] then
		local ok, err = pcall(Commands[cmd].func, args, PrintLine, PrintOk, PrintErr, PrintWarn, PrintInfo)
		if not ok then PrintErr(tostring(err)) end
		return
	end

	PrintErr("command not found: '" .. cmd .. "'  —  type 'help' to list commands")
end

-- // ── Input handling ───────────────────────────────────────────────

InputBox.FocusLost:Connect(function(enter)
	if enter then
		local t = InputBox.Text
		InputBox.Text = ""
		Execute(t)
	end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe or not InputBox:IsFocused() then return end
	if input.KeyCode == Enum.KeyCode.Up then
		histIdx = math.min(histIdx + 1, #history)
		InputBox.Text = history[histIdx] or ""
		InputBox.CursorPosition = #InputBox.Text + 1
	elseif input.KeyCode == Enum.KeyCode.Down then
		histIdx = math.max(histIdx - 1, 0)
		InputBox.Text = history[histIdx] or ""
		InputBox.CursorPosition = #InputBox.Text + 1
	end
end)

